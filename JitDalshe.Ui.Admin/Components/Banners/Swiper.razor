@using JitDalshe.Ui.Admin.Models
@using JitDalshe.Ui.Admin.Services.SwiperService
@inject ISwiperService SwiperService

<div id="@_swiperId" class="swiper mySwiper">
    <div class="swiper-wrapper">
        @foreach (var item in Items)
        {
            if (item.RedirectOnClickUrl is not null)
            {
                <a class="swiper-slide"
                   href="@item.RedirectOnClickUrl"
                   target="_blank">
                    <img src="@(IsMobile ? item.MobileImageUrl : item.ImageUrl)" alt="@item.Title">
                </a>
            }
            else
            {
                <div class="swiper-slide">
                    <img src="@(IsMobile ? item.MobileImageUrl : item.ImageUrl)" alt="@item.Title">
                </div>
            }
        }
    </div>

    <div class="swiper-pagination"></div>
    <div class="swiper-button-next"></div>
    <div class="swiper-button-prev"></div>
</div>

@code {
    private readonly string _swiperId = $"swiper-{Guid.NewGuid().ToString("N")}";

    [Parameter] public required PreviewBanner[] Items { get; init; } = [];
    [Parameter] public bool IsMobile { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await SwiperService.InitSwiperAsync($"#{_swiperId}");
        }
    }

}