@typeparam TValue
@using Microsoft.AspNetCore.Components.Forms
@using System.Linq.Expressions
<div class="form-group">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label for="@_id">@Label</label>
    }
    
    <InputDate id="@_id"
               Type="@Type"
               class="@Style"
               Value="@Value"
               ValueExpression="@ValueExpression"
               ValueChanged="@((TValue? v) => ValueChangedAsync(v))"/>
    
    <ValidationMessage For="@ValueExpression"/>
</div>

@code {

    private readonly string _id = Guid.NewGuid().ToString();
    
    [CascadingParameter] EditContext? EditContext { get; set; }
    private FieldIdentifier _fieldIdentifier;

    private string Style => EditContext?.GetValidationMessages(_fieldIdentifier).Any() is true
        ? "form-control is-invalid"
        : "form-control";

    [Parameter] public required string Label { get; init; }
    [Parameter] public TValue? Value { get; set; }
    [Parameter] public EventCallback<TValue?> ValueChanged { get; init; }
    [Parameter] public Expression<Func<TValue?>> ValueExpression { get; set; } = null!;
    [Parameter] public InputDateType Type { get; set; } = InputDateType.Date;
    
    private async Task ValueChangedAsync(TValue? newValue)
    {
        bool hasChanged = !EqualityComparer<TValue>.Default.Equals(Value, newValue);
        if (hasChanged)
        {
            Value = newValue;
            await ValueChanged.InvokeAsync(Value);
            
            if (EditContext is not null)
            {
                EditContext.NotifyFieldChanged(_fieldIdentifier);
            }
        }
    }

    protected override void OnParametersSet()
    {
        _fieldIdentifier = FieldIdentifier.Create(ValueExpression);

        if (typeof(TValue) == typeof(TimeOnly) || typeof(TValue) == typeof(TimeOnly?))
        {
            Type = InputDateType.Time;
        }
    }

}