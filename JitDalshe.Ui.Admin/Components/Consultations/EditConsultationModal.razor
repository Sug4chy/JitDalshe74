@using JitDalshe.Ui.Admin.Components.Shared.Forms
@using JitDalshe.Ui.Admin.Components.Shared.Modals
@using JitDalshe.Ui.Admin.Models
@using JitDalshe.Ui.Admin.Models.Common
@using JitDalshe.Ui.Admin.Services.ConsultationService
@using JitDalshe.Ui.Admin.Services.ModalService
@inject IModalService ModalService
@inject IConsultationService ConsultationService
@inject IToastService ToastService

<Modal Id="@Id"
       Title="Изменение статуса и комментария заявки"
       Footer="Modal.FooterType.Button"
       FooterButtonText="Сохранить"
       OnFooterButtonClick="@SaveStatusAsync">

    <h6 class="text-muted mb-3">Информация о пациенте:</h6>
        
    <InfoRow Label="ФИО пациента" Value="@Request.PatientName" />
    <InfoRow Label="Возраст" Value="@($"{Request.PatientAge} лет")" />
    <InfoRow Label="Дата подачи заявки" Value="@Request.Date.ToString("dd.MM.yyyy")" />
    <InfoRow Label="Желаемый способ связи" Value="@Request.CommunicationMethodsString" />
        
    @if (!string.IsNullOrWhiteSpace(Request.PatientPhoneNumber))
    {
        <InfoRow Label="Номер телефона" Value="@Request.PatientPhoneNumber" />
    }
    @if (!string.IsNullOrWhiteSpace(Request.PatientEmail))
    {
        <InfoRow Label="Электронная почта" Value="@Request.PatientEmail" />
    }
    
    <div class="mb-3">
        <label class="form-label">Статус заявки:</label>
        <InputSelect class="form-select" @bind-Value="_selectedStatus">
            <option value="@RequestStatus.New">Новая</option>
            <option value="@RequestStatus.InProgress">В обработке</option>
            <option value="@RequestStatus.Completed">Обработана</option>
        </InputSelect>
    </div>
    
    <div class="mb-3">
        <label class="form-label">Комментарий:</label>
        <InputTextArea class="form-control" 
                       @bind-Value="_comment" 
                       rows="4" 
                       placeholder="Ваш комментарий..." />
    </div>
</Modal>

@code {
    [Parameter] public required string Id { get; init; }
    [Parameter] public required ConsultationRequest Request { get; init; }
    [Parameter] public required EventCallback OnStatusChanged { get; init; }
    
    private RequestStatus _selectedStatus;
    private string? _comment;

    protected override void OnParametersSet()
    {
        _selectedStatus = Request.Status;
        _comment = Request.Comment;
    }

    private async Task SaveStatusAsync()
    {
        bool statusChanged = _selectedStatus != Request.Status;
        bool commentChanged = _comment != Request.Comment;
        
        if (!statusChanged && !commentChanged)
        {
            await ModalService.HideModalAsync($"#{Id}");
            return;
        }
        
        bool success = true;
        
        if (statusChanged)
        {
            success = await ConsultationService.ChangeStatusAsync(Request.Id, _selectedStatus);
            if (!success) return;
            ToastService.ShowSuccess("Статус успешно изменён!");
        }
        
        if (commentChanged)
        {
            success = await ConsultationService.UpdateCommentAsync(Request.Id, _comment);
            if (!success) return;
            ToastService.ShowSuccess("Комментарий успешно обновлён!");
        }
        
        await ModalService.HideModalAsync($"#{Id}");
        await OnStatusChanged.InvokeAsync();
    }
}