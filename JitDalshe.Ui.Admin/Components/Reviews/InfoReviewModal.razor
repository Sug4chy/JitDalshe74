@using JitDalshe.Ui.Admin.Components.Shared.Forms
@using JitDalshe.Ui.Admin.Components.Shared.Modals
@using JitDalshe.Ui.Admin.Models
@using JitDalshe.Ui.Admin.Services.ModalService
@using JitDalshe.Ui.Admin.Services.ReviewService
@inject IModalService ModalService
@inject IToastService ToastService
@inject IReviewService ReviewService

<Modal Id="@Id"
       Title="Новый отзыв"
       Footer="Modal.FooterType.Button"
       FooterButtonText="Сохранить"
       OnFooterButtonClick="@SaveChangesAsync">

    <InfoRow Label="Имя" Value="@($"{Review.ReviewerName} ({Review.ReviewerAgeString})")" />
    <InfoRow Label="Статус автора" Value="@Review.ReviewerStatusString" />
    <InfoRow Label="Оставлен" Value="@Review.Date.ToString("dd-MM-yyyy")" />
    
    <TextBox Label="Текст отзыва:">
        @Review.Text
    </TextBox>
    
    <div class="mb-3">
        <label class="form-label fw-bold">Статус отзыва:</label>
        <InputSelect class="form-select" @bind-Value="_selectedStatus">
            <option value="@ReviewStatus.New">Новый</option>
            <option value="@ReviewStatus.InProgress">В обработке</option>
            <option value="@ReviewStatus.Published">Опубликован</option>
            <option value="@ReviewStatus.NotPublished">Не публиковать</option>
        </InputSelect>
    </div>
    
</Modal>

@code {

    [Parameter] public required string Id { get; init; }
    [Parameter] public required Review Review { get; init; }
    [Parameter] public required EventCallback OnReviewStatusChanged { get; init; }


    private ReviewStatus _selectedStatus;

    protected override void OnParametersSet()
    {
        _selectedStatus = Review.Status;
    }

    private async Task SaveChangesAsync()
    {
        if (_selectedStatus == Review.Status)
        {
            await ModalService.HideModalAsync($"#{Id}");
            return;
        }

        var success = await ReviewService.ChangeStatusAsync(Review.Id, _selectedStatus);
        if (success)
        {
            ToastService.ShowSuccess("Статус отзыва успешно обновлен!");
            await ModalService.HideModalAsync($"#{Id}");
            await OnReviewStatusChanged.InvokeAsync();
        }
    }
}
