@using JitDalshe.Ui.Admin.Components.Shared.Cards
@using JitDalshe.Ui.Admin.Models
@using JitDalshe.Ui.Admin.Services.ModalService
@using JitDalshe.Ui.Admin.Services.ReviewService
@inject IModalService ModalService
@inject IReviewService ReviewService
@inject IToastService ToastService

<Card HeaderText="@CardHeaderText"
      Title="@CardTitle"
      Buttons="Card.Button.Info | Card.Button.Delete"
      OnInfoButtonClick="@ShowInfoModalAsync"
      OnDeleteButtonClick="@DeleteReviewAsync"/>

<InfoReviewModal Id="@InfoModalId" Review="@Review" OnReviewStatusChanged="@OnReviewStatusChanged"/>

@code {

    private string CardHeaderText => $"Статус: {StatusToString(Review.Status)} — Оставлен {Review.Date.ToString("dd-MM-yyyy")}";
    private string CardTitle => $"Отзыв от {Review.ReviewerName}, {Review.ReviewerAgeString}";
    private string InfoModalId => $"modal_info_review_{Review.Id}";

    [Parameter] public required Review Review { get; init; }
    [Parameter] public required EventCallback OnReviewStatusChanged { get; init; }
    [Parameter] public required EventCallback OnReviewDeleted { get; init; }

    private Task ShowInfoModalAsync()
        => ModalService.ShowModalAsync($"#{InfoModalId}");

    private Task DeleteReviewAsync()
        => ReviewService.DeleteReviewAsync(
            reviewId: Review.Id,
            onSuccess: async () =>
            {
                ToastService.ShowSuccess("Отзыв успешно удалён!");
                await OnReviewDeleted.InvokeAsync();
            });

    private static string StatusToString(ReviewStatus s) => s switch
    {
        ReviewStatus.New => "Новый",
        ReviewStatus.InProgress => "В обработке",
        ReviewStatus.Published => "Опубликован",
        ReviewStatus.NotPublished => "Не публиковать",
        _ => s.ToString()
    };
}