@using JitDalshe.Ui.Admin.Components.Shared.Cards
@using JitDalshe.Ui.Admin.Models
@using JitDalshe.Ui.Admin.Models.Common
@using JitDalshe.Ui.Admin.Services.ModalService
@inject IModalService ModalService

<Card HeaderText="@HeaderText" 
      Title="@CardTitle"
      Comment="@Comment"
      Buttons="Card.Button.Edit"
      OnEditButtonClick="@ShowEditModalAsync"
/>

<EditVolunteerModal Id="@EditModalId" 
                       Request="@Request" 
                       OnStatusChanged="@OnStatusChanged"/>

@code {
    [Parameter] public required VolunteerRequest Request { get; init; }
    [Parameter] public required EventCallback OnStatusChanged { get; init; }
    private string HeaderText => $"{Request.Date.ToString("dd.MM.yyyy")} - {StatusToString(Request.Status)}";

    private string CardTitle => $"{Request.ApplicantName} ({Request.ApplicantAge} лет) - {Request.CommunicationMethodsString} - {ContactInfo}";
    private string EditModalId => $"modal_edit_volunteer_{Request.Id}";
    
    private string? Comment => string.IsNullOrWhiteSpace(Request.Comment) 
        ? null 
        : Request.Comment;
    
    private string ContactInfo
    {
        get
        {
            bool wantsPhone = Request.CommunicationMethods.HasFlag(CommunicationMethod.CallAPhone) || 
                              Request.CommunicationMethods.HasFlag(CommunicationMethod.WhatsApp) || 
                              Request.CommunicationMethods.HasFlag(CommunicationMethod.Telegram);
            
            bool wantsEmail = Request.CommunicationMethods.HasFlag(CommunicationMethod.Email);

            string? phone = wantsPhone ? Request.ApplicantPhoneNumber : null;
            string? email = wantsEmail ? Request.ApplicantEmail : null;
            
            if (!string.IsNullOrWhiteSpace(phone) && !string.IsNullOrWhiteSpace(email))
            {
                return $"Номер: {phone} / email: {email}";
            }
            
            if (!string.IsNullOrWhiteSpace(phone))
            {
                return $"Номер: {phone}";
            }
            
            if (!string.IsNullOrWhiteSpace(email))
            {
                return $"email: {email}";
            }

            return "Контакты для связи не указаны";
        }
    }
    
    private Task ShowEditModalAsync()
        => ModalService.ShowModalAsync($"#{EditModalId}");
    
    private static string StatusToString(RequestStatus s) => s switch
    {
        RequestStatus.New => "Новая",
        RequestStatus.InProgress => "В обработке",
        RequestStatus.Completed => "Обработана",
        _ => s.ToString()
    };
}