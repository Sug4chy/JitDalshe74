@page "/banners"
@using JitDalshe.Ui.Admin.Models
@using JitDalshe.Ui.Admin.Components.Banners
@using JitDalshe.Ui.Admin.Services.BannerService
@using JitDalshe.Ui.Admin.Services.ModalService
@inject IModalService ModalService
@inject IBannerService BannerService

<PageTitle>Баннеры</PageTitle>

<h1 class="mb-4">Баннеры</h1>

@if (_previewBanners is { Length: > 0 })
{
    <h2>Предпросмотр активных баннеров</h2>

    <div class="row mb-5">
        <div class="col-md-9">
            <p class="text-muted fw-bold mb-2">Десктопная версия:</p>
            <BannersSlider @key="@_sliderVersion" Items="@_previewBanners" IsMobile="false"/>
        </div>
        
        <div class="col-md-3">
            <p class="text-muted fw-bold mb-2">Мобильная версия:</p>
            <BannersSlider @key="@_sliderVersion" Items="@_previewBanners" IsMobile="true"/>
        </div>
    </div>
}

<div class="topbar-container">
    <h2>Полный список баннеров</h2>
    <button class="btn btn-secondary btn-show-create-modal"
            @onclick="ShowCreateBannerModalAsync">
        + Добавить
    </button>
</div>

@if (_banners is not null)
{
    @foreach (var banner in _banners)
    {
        <BannerCard Banner="banner" BannerEdited="OnInitializedAsync" BannerDeleted="OnInitializedAsync"/>
    }
}
else
{
    <SpinnerLoader/>
}

<CreateBannerModal Id="@CreateBannerModalId" BannerCreated="@OnInitializedAsync"/>

@code {

    private const string CreateBannerModalId = "modal_create_banner";

    private PreviewBanner[] _previewBanners = null!;
    private string _sliderVersion = Guid.NewGuid().ToString();

    private Banner[] _banners = null!;

    private Task ShowCreateBannerModalAsync()
        => ModalService.ShowModalAsync($"#{CreateBannerModalId}");

    private async Task LoadPreviewBannersAsync()
    {
        var rawPreviewBanners = await BannerService.FindPreviewBannersAsync();
        var buster = Guid.NewGuid().ToString();

        _previewBanners = rawPreviewBanners
            .Select(x => x with { 
                ImageUrl = AppendCacheBuster(x.ImageUrl, buster)
            })
            .ToArray();
        
        _sliderVersion = Guid.NewGuid().ToString();
    }

    private async Task LoadBannersAsync()
    {
        var rawBanners = await BannerService.FindAllAsync();
        var buster = Guid.NewGuid().ToString();

        _banners = rawBanners
            .Select(x => x with { 
                ImageUrl = AppendCacheBuster(x.ImageUrl, buster),
                MobileImageUrl = AppendCacheBuster(x.MobileImageUrl, buster)
            })
            .ToArray();
    }
    
    private static string AppendCacheBuster(string url, string buster)
    {
        if (string.IsNullOrEmpty(url)) return url;
        char separator = url.Contains('?') ? '&' : '?';
        return $"{url}{separator}v={buster}";
    }

    private async Task LoadAllBanners()
    {
        await LoadPreviewBannersAsync();
        await LoadBannersAsync();
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAllBanners();
    }
}